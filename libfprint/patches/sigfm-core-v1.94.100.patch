+} SensitiveVariantData;
+
+static void
+sensitive_variant_data_free (SensitiveVariantData *holder)
+{
+  volatile guchar *cursor;
+  gsize length;
+
+  if (holder == NULL)
+    return;
+  cursor = holder->data;
+  length = holder->length;
+  while (length-- > 0)
+    *cursor++ = 0;
+  g_free (holder);
+}
+
+static GPtrArray *
+serialize_sigfm_gallery (FpPrint *print, GError **error)
+{
+  g_autoptr(GPtrArray) samples =
+    g_ptr_array_new_with_free_func ((GDestroyNotify) sensitive_variant_data_free);
+
+  if (print->prints == NULL ||
+      print->prints->len < SIGFM_ENROLL_SAMPLES ||
+      print->prints->len > SIGFM_MAX_ENROLL_SAMPLES)
+    {
+      g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA,
+                           "SIGFM gallery must contain 8 to 24 samples");
+      return NULL;
+    }
+  for (guint i = 0; i < print->prints->len; i++)
+    {
+      gsize serialized_len = 0;
+      guchar *serialized = sigfm_serialize (
+        g_ptr_array_index (print->prints, i), &serialized_len);
+      SensitiveVariantData *holder;
+
+      if (serialized == NULL || serialized_len == 0 ||
+          serialized_len > SIGFM_MAX_SAMPLE_SIZE)
+        {
+          sigfm_free_serialized (serialized, serialized_len);
+          g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA,
+                               "SIGFM sample serialization failed");
+          return NULL;
+        }
+      holder = g_malloc (sizeof *holder + serialized_len);
+      holder->length = serialized_len;
+      memcpy (holder->data, serialized, serialized_len);
+      sigfm_free_serialized (serialized, serialized_len);
+      g_ptr_array_add (samples, holder);
+    }
+  return g_steal_pointer (&samples);
+}
 
