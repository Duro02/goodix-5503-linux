+typedef struct
+{
+  gboolean owns_detection;
+} SigfmDetectionTaskData;
+
+static SigfmDetectionTaskData *
+sigfm_detection_task_data_new (void)
+{
+  return g_new0 (SigfmDetectionTaskData, 1);
+}
+
+static void
+sigfm_detection_task_release (FpImage *self, GTask *task)
+{
+  SigfmDetectionTaskData *data = g_task_get_task_data (task);
+  gboolean changed;
+
+  if (!data->owns_detection)
+    return;
+  changed = g_atomic_int_compare_and_exchange (&self->detection_in_progress,
+                                                TRUE, FALSE);
+  g_assert (changed);
+  data->owns_detection = FALSE;
+}
+
+static void
+fp_image_detect_sigfm_thread_func (GTask        *task,
+                                   gpointer      source_object,
+                                   gpointer      task_data,
+                                   GCancellable *cancellable)
+{
+  g_autoptr(GTask) thread_task = g_steal_pointer (&task);
+  FpImage *self = source_object;
+  SigfmImgInfo *info;
+
+  (void) task_data;
+  (void) cancellable;
+  if (g_task_return_error_if_cancelled (thread_task))
+    return;
+  info = sigfm_extract (self->data, self->width, self->height);
+  if (info == NULL || sigfm_keypoints_count (info) < 20)
+    {
+      g_clear_pointer (&info, sigfm_free_info);
+      g_task_return_new_error (thread_task, G_IO_ERROR, G_IO_ERROR_FAILED,
+                               "Insufficient SIGFM features");
+      return;
+    }
+  if (g_task_return_error_if_cancelled (thread_task))
+    {
+      sigfm_free_info (info);
+      return;
+    }
+  g_task_return_pointer (thread_task, info, (GDestroyNotify) sigfm_free_info);
+}
+
+void
+fpi_image_detect_sigfm (FpImage            *self,
+                        GCancellable       *cancellable,
+                        GAsyncReadyCallback callback,
+                        gpointer            user_data)
+{
+  g_autoptr(GTask) task = NULL;
+
+  g_return_if_fail (FP_IS_IMAGE (self));
+  g_return_if_fail (callback != NULL);
+  task = g_task_new (self, cancellable, callback, user_data);
+  g_task_set_source_tag (task, fpi_image_detect_sigfm);
+  g_task_set_check_cancellable (task, TRUE);
+  g_task_set_task_data (task, sigfm_detection_task_data_new (), g_free);
+  if (!g_atomic_int_compare_and_exchange (&self->detection_in_progress,
+                                          FALSE, TRUE))
+    {
+      g_task_return_new_error (task, G_IO_ERROR, G_IO_ERROR_ADDRESS_IN_USE,
+                               "Image feature detection is already in progress");
+      return;
+    }
+  ((SigfmDetectionTaskData *) g_task_get_task_data (task))->owns_detection = TRUE;
+  g_task_run_in_thread (g_steal_pointer (&task),
+                        fp_image_detect_sigfm_thread_func);
+}
+
+gboolean
+fpi_image_detect_sigfm_finish (FpImage      *self,
+                               GAsyncResult *result,
+                               GError      **error)
+{
+  GTask *task;
+  SigfmImgInfo *info;
+
+  g_return_val_if_fail (FP_IS_IMAGE (self), FALSE);
+  g_return_val_if_fail (g_task_is_valid (result, self), FALSE);
+  g_return_val_if_fail (g_task_get_source_tag (G_TASK (result)) ==
+                        fpi_image_detect_sigfm, FALSE);
+  task = G_TASK (result);
+  sigfm_detection_task_release (self, task);
+  info = g_task_propagate_pointer (task, error);
+  if (info == NULL)
+    return FALSE;
+  g_clear_pointer (&self->sigfm_info, sigfm_free_info);
+  self->sigfm_info = info;
+  return TRUE;
+}
+
+SigfmImgInfo *
+fpi_image_steal_sigfm_info (FpImage *self)
+{
+  g_return_val_if_fail (FP_IS_IMAGE (self), NULL);
+  return g_steal_pointer (&self->sigfm_info);
+}
