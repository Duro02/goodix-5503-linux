+gboolean
+fpi_print_sigfm_enroll_collect (GPtrArray *pool, FpPrint *sample,
+                                gint threshold, GError **error)
+{
+  SigfmImgInfo *probe, *copy;
+
+  g_return_val_if_fail (error == NULL || *error == NULL, FALSE);
+  if (!pool || pool->len >= SIGFM_ENROLL_POOL_SAMPLES || threshold <= 0 ||
+      !sample || sample->type != FPI_PRINT_SIGFM || !sample->prints ||
+      sample->prints->len != 1 ||
+      sigfm_keypoints_count (sample->prints->pdata[0]) < 20)
+    {
+      g_set_error_literal (error, FP_DEVICE_ERROR, FP_DEVICE_ERROR_DATA_INVALID,
+                           "Invalid SIGFM enrollment sample pool");
+      return FALSE;
+    }
+  probe = sample->prints->pdata[0];
+  for (guint i = 0; i < pool->len; i++)
+    {
+      gint redundant = sigfm_is_redundant (probe, pool->pdata[i], threshold);
+      if (redundant < 0)
+        {
+          g_set_error_literal (error, FP_DEVICE_ERROR, FP_DEVICE_ERROR_GENERAL,
+                               "SIGFM enrollment comparison failed");
+          return FALSE;
+        }
+      if (redundant)
+        {
+          g_set_error_literal (error, FP_DEVICE_RETRY, FP_DEVICE_RETRY_CENTER_FINGER,
+                               "Sample is too similar; slightly reposition and retry");
+          return FALSE;
+        }
+    }
+  copy = sigfm_copy_info (probe);
+  if (!copy)
+    {
+      g_set_error_literal (error, FP_DEVICE_ERROR, FP_DEVICE_ERROR_GENERAL,
+                           "SIGFM enrollment copy failed");
+      return FALSE;
+    }
+  g_ptr_array_add (pool, copy);
+  return TRUE;
+}
+
+gboolean
+fpi_print_sigfm_enroll_select (FpPrint *gallery, GPtrArray *pool,
+                               gint threshold, GError **error)
+{
+  SigfmImgInfo *samples[SIGFM_ENROLL_POOL_SAMPLES];
+  unsigned selected[SIGFM_ENROLL_TARGET_SAMPLES];
+  g_autoptr(GPtrArray) result = NULL;
+
+  g_return_val_if_fail (error == NULL || *error == NULL, FALSE);
+  if (!gallery || gallery->type != FPI_PRINT_SIGFM || !gallery->prints ||
+      gallery->prints->len != 0 || !pool || pool->len != SIGFM_ENROLL_POOL_SAMPLES)
+    {
+      g_set_error_literal (error, FP_DEVICE_ERROR, FP_DEVICE_ERROR_DATA_INVALID,
+                           "Enrollment must select from a fresh complete sample pool");
+      return FALSE;
+    }
+  for (guint i = 0; i < pool->len; i++)
+    samples[i] = pool->pdata[i];
+  if (sigfm_select_enrollment (samples, pool->len, threshold, selected,
+                                SIGFM_ENROLL_TARGET_SAMPLES) < 0)
+    {
+      g_set_error_literal (error, FP_DEVICE_ERROR, FP_DEVICE_ERROR_GENERAL,
+                           "SIGFM enrollment selection failed");
+      return FALSE;
+    }
+  result = g_ptr_array_new_with_free_func ((GDestroyNotify) sigfm_free_info);
+  for (guint i = 0; i < SIGFM_ENROLL_TARGET_SAMPLES; i++)
+    {
+      SigfmImgInfo *copy = sigfm_copy_info (samples[selected[i]]);
+      if (!copy)
+        {
+          g_set_error_literal (error, FP_DEVICE_ERROR, FP_DEVICE_ERROR_GENERAL,
+                               "SIGFM selected reference copy failed");
+          return FALSE;
+        }
+      g_ptr_array_add (result, copy);
+    }
+  g_ptr_array_unref (gallery->prints);
+  gallery->prints = g_steal_pointer (&result);
+  return TRUE;
+}
+
+gint
+fpi_print_sigfm_enroll_check (FpPrint *gallery, FpPrint *sample,
+                              gint threshold, guint *checked,
+                              guint *matched, GError **error)
+{
+  FpiMatchResult match = FPI_MATCH_FAIL;
+
+  g_return_val_if_fail (error == NULL || *error == NULL, -1);
+  if (!gallery || gallery->type != FPI_PRINT_SIGFM || !gallery->prints ||
+      gallery->prints->len != SIGFM_ENROLL_TARGET_SAMPLES || threshold <= 0 ||
+      !checked || !matched || *checked >= SIGFM_ENROLL_CHECK_SAMPLES ||
+      *matched > *checked)
+    {
+      g_set_error_literal (error, FP_DEVICE_ERROR, FP_DEVICE_ERROR_DATA_INVALID,
+                           "Invalid SIGFM enrollment validation state");
+      return -1;
+    }
+  if (sample)
+    {
+      match = fpi_print_sigfm_match (gallery, sample, threshold, error);
+      if (match == FPI_MATCH_ERROR)
+        return -1;
+    }
+  /* A missing/poor scan counts as a failed check, never as more training. */
+  (*checked)++;
+  *matched += match == FPI_MATCH_SUCCESS;
+  if (*checked < SIGFM_ENROLL_CHECK_SAMPLES)
+    return 0;
+  if (*matched < SIGFM_ENROLL_CHECK_REQUIRED)
+    {
+      g_set_error (error, FP_DEVICE_ERROR, FP_DEVICE_ERROR_GENERAL,
+                    "Enrollment coverage check failed: %u/%u matched; collect more varied natural placements",
+                    *matched, SIGFM_ENROLL_CHECK_SAMPLES);
+      return -1;
+    }
+  return 1;
+}
+
+gboolean
+fpi_print_sigfm_is_duplicate (FpPrint *gallery,
+                                FpPrint *sample,
+                                gint     threshold,
+                                GError **error)
+{
+  SigfmImgInfo *probe;
+
+  g_return_val_if_fail (error == NULL || *error == NULL, FALSE);
+  if (gallery == NULL || sample == NULL || threshold <= 0 ||
+      gallery->type != FPI_PRINT_SIGFM ||
+      sample->type != FPI_PRINT_SIGFM ||
+      gallery->prints == NULL ||
+      gallery->prints->len > SIGFM_MAX_ENROLL_SAMPLES ||
+      sample->prints == NULL || sample->prints->len != 1)
+    {
+      g_set_error_literal (error, FP_DEVICE_ERROR, FP_DEVICE_ERROR_DATA_INVALID,
+                           "Invalid SIGFM duplicate check data");
+      return FALSE;
+    }
+
+  probe = g_ptr_array_index (sample->prints, 0);
+  for (guint index = 0; index < gallery->prints->len; index++)
+    {
+      gint redundant = sigfm_is_redundant (
+        probe, g_ptr_array_index (gallery->prints, index),
+        threshold);
+      if (redundant < 0)
+        {
+          g_set_error_literal (error, FP_DEVICE_ERROR,
+                               FP_DEVICE_ERROR_GENERAL,
+                               "SIGFM duplicate check failed");
+          return FALSE;
+        }
+      if (redundant > 0)
+        return TRUE;
+    }
+  return FALSE;
+}
+
+FpiMatchResult
+fpi_print_sigfm_match (FpPrint *template,
+                       FpPrint *print,
+                       gint     threshold,
+                       GError **error)
+{
+  SigfmImgInfo *probe;
+
+  if (template == NULL || print == NULL || threshold <= 0 ||
+      template->type != FPI_PRINT_SIGFM || print->type != FPI_PRINT_SIGFM ||
+      template->prints == NULL || template->prints->len == 0 ||
+      (template->prints->len < SIGFM_ENROLL_SAMPLES ||
+       template->prints->len > SIGFM_MAX_ENROLL_SAMPLES) ||
+      print->prints == NULL || print->prints->len != 1)
+    {
+      g_set_error_literal (error, FP_DEVICE_ERROR, FP_DEVICE_ERROR_DATA_INVALID,
+                           "Invalid SIGFM print data");
+      return FPI_MATCH_ERROR;
+    }
+
+  probe = g_ptr_array_index (print->prints, 0);
+  for (guint index = 0; index < template->prints->len; index++)
+    {
+      gint score = sigfm_match_score (probe,
+                                      g_ptr_array_index (template->prints,
+                                                         index));
+      if (score < 0)
+        {
+          g_set_error_literal (error, FP_DEVICE_ERROR,
+                               FP_DEVICE_ERROR_GENERAL,
+                               "SIGFM matching failed");
+          return FPI_MATCH_ERROR;
+        }
+      if (score >= threshold)
+        return FPI_MATCH_SUCCESS;
+    }
   return FPI_MATCH_FAIL;
 }
 
