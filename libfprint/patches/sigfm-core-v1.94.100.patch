+static void
+secure_wipe (gpointer buffer, gsize length)
+{
+  volatile guint8 *cursor = buffer;
+
+  while (length-- > 0)
+    *cursor++ = 0;
+}
+
+static void
+secure_minutia_free (struct fp_minutia *minutia)
+{
+  gsize ridge_count = 0;
+
+  if (minutia == NULL)
+    return;
+  if (minutia->num_nbrs >= 0 && minutia->num_nbrs <= MAX_NBRS)
+    ridge_count = minutia->num_nbrs;
+  if (minutia->nbrs)
+    {
+      secure_wipe (minutia->nbrs, MAX_NBRS * sizeof *minutia->nbrs);
+      g_clear_pointer (&minutia->nbrs, g_free);
+    }
+  if (minutia->ridge_counts)
+    {
+      secure_wipe (minutia->ridge_counts,
+                   ridge_count * sizeof *minutia->ridge_counts);
+      g_clear_pointer (&minutia->ridge_counts, g_free);
+    }
+  secure_wipe (minutia, sizeof *minutia);
+  g_free (minutia);
+}
+
+static void
+secure_minutiae_array_free (GPtrArray *minutiae)
+{
+  if (minutiae == NULL)
+    return;
+  g_ptr_array_set_free_func (minutiae, NULL);
+  for (guint i = 0; i < minutiae->len; i++)
+    secure_minutia_free (g_ptr_array_index (minutiae, i));
+  g_ptr_array_unref (minutiae);
+}
+
+static void
+secure_nbis_minutiae_free (struct fp_minutiae *minutiae)
+{
+  if (minutiae == NULL)
+    return;
+  for (gint i = 0; i < minutiae->num; i++)
+    secure_minutia_free (minutiae->list[i]);
+  if (minutiae->list)
+    {
+      secure_wipe (minutiae->list,
+                   minutiae->num * sizeof *minutiae->list);
+      g_clear_pointer (&minutiae->list, g_free);
+    }
+  secure_wipe (minutiae, sizeof *minutiae);
+  g_free (minutiae);
+}
