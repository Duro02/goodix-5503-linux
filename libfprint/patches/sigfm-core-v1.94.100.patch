+sigfm_enrollment_selection_thread (GTask *task, gpointer source,
+                                    gpointer task_data, GCancellable *cancellable)
+{
+  SigfmEnrollmentSelection *data = task_data;
+  g_autoptr(GError) error = NULL;
+  (void) source;
+  (void) cancellable;
+  if (g_task_return_error_if_cancelled (task))
+    return;
+  if (!fpi_print_sigfm_enroll_select (data->selected, data->pool,
+                                      data->threshold, &error))
+    {
+      g_task_return_error (task, g_steal_pointer (&error));
+      return;
+    }
+  if (g_task_return_error_if_cancelled (task))
+    return;
+  g_task_return_pointer (task, g_steal_pointer (&data->selected), g_object_unref);
+}
+
+static void
+sigfm_enrollment_selection_done (GObject *object, GAsyncResult *result, gpointer user_data)
+{
+  FpImageDevice *self = FP_IMAGE_DEVICE (object);
+  FpDevice *device = FP_DEVICE (self);
+  FpImageDevicePrivate *priv = fp_image_device_get_instance_private (self);
+  g_autoptr(GError) error = NULL;
+  g_autoptr(FpPrint) selected = g_task_propagate_pointer (G_TASK (result), &error);
+  FpPrint *gallery;
+  (void) user_data;
+
+  priv->minutiae_scan_active = FALSE;
+  if (!selected || priv->action_error)
+    {
+      fp_image_device_maybe_complete_action (self, g_steal_pointer (&error));
+      fpi_image_device_deactivate (self, TRUE);
+      return;
+    }
+  fpi_device_get_enroll_data (device, &gallery);
+  g_ptr_array_unref (gallery->prints);
+  gallery->prints = g_steal_pointer (&selected->prints);
+  g_clear_pointer (&priv->sigfm_enroll_samples, g_ptr_array_unref);
+  fp_dbg ("SIGFM enrollment selected 24 references from 40 fresh samples; starting held-out checks");
+  fpi_device_enroll_progress (device, priv->enroll_stage, NULL, NULL);
+  if (!fpi_device_action_is_cancelled (device))
+    fp_image_device_enroll_maybe_await_finger_on (self);
+}
+
+static void
+fp_image_device_sigfm_select (FpImageDevice *self)
+{
+  FpImageDevicePrivate *priv = fp_image_device_get_instance_private (self);
+  FpDevice *device = FP_DEVICE (self);
+  SigfmEnrollmentSelection *data = g_new0 (SigfmEnrollmentSelection, 1);
+  g_autoptr(GTask) task = NULL;
+
+  data->pool = g_ptr_array_ref (priv->sigfm_enroll_samples);
+  data->selected = fp_print_new (device);
+  fpi_print_set_type (data->selected, FPI_PRINT_SIGFM);
+  data->threshold = priv->sigfm_threshold;
+  /* Keep processing USB/lift/cancel events while comparing the pool, but
+   * withhold the next DOWN arm until selection has finished. */
+  priv->minutiae_scan_active = TRUE;
+  task = g_task_new (self, fpi_device_get_cancellable (device),
+                      sigfm_enrollment_selection_done, NULL);
+  g_task_set_task_data (task, data, sigfm_enrollment_selection_free);
+  g_task_run_in_thread (task, sigfm_enrollment_selection_thread);
+}
+
+static gboolean
+fp_image_device_sigfm_check (FpImageDevice *self, FpPrint *sample)
+{
+  FpImageDevicePrivate *priv = fp_image_device_get_instance_private (self);
+  FpDevice *device = FP_DEVICE (self);
+  FpPrint *gallery;
+  g_autoptr(GError) error = NULL;
+
+  fpi_device_get_enroll_data (device, &gallery);
+  gint result = fpi_print_sigfm_enroll_check (
+    gallery, sample, priv->sigfm_threshold, &priv->sigfm_checks,
+    &priv->sigfm_checks_matched, &error);
+  priv->enroll_stage = SIGFM_ENROLL_POOL_SAMPLES + priv->sigfm_checks;
+  fp_dbg ("SIGFM enrollment held-out check %u/%u: matched=%u",
+          priv->sigfm_checks, SIGFM_ENROLL_CHECK_SAMPLES, priv->sigfm_checks_matched);
+  if (result < 0)
+    {
+      fp_image_device_maybe_complete_action (self, g_steal_pointer (&error));
+      fpi_image_device_deactivate (self, TRUE);
+      return FALSE;
+    }
+  return TRUE;
 }
 
